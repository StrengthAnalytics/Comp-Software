# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only. Never expose to the client. Never log.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by the retained `db:*` scripts.
# Not part of the online-only workflow — development runs against the hosted project.
SUPABASE_DB_URL=

# --- Resend (Supabase SMTP provider for auth emails, and the app's own notification emails) ---
# Server-only. With no key set, the app sends no emails (the rota's change-request alerts are skipped).
RESEND_API_KEY=
# Sender for the app's emails, e.g. "Comp Software <rota@yourdomain>" on a domain verified in Resend.
# Blank uses Resend's test sender, which only delivers to the Resend account owner's own address.
RESEND_FROM_EMAIL=
# Fallbacks for a competition with no Organiser email set on its edit screen (that per-comp address wins):
# where replies to the app's emails to lifters go. Blank = the emails ask people not to reply.
RESEND_REPLY_TO_EMAIL=
# ...and who is emailed when a volunteer sends a rota "Request a change" (comma-separated). Blank = ADMIN_EMAILS.
ROTA_NOTIFY_EMAILS=

# --- Sentry ---
# DSN is safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (CI/Vercel only).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Admin allowlist ---
# Comma-separated emails permitted to sign in and write. Server-only (no NEXT_PUBLIC_ prefix).
# These are the only accounts that should ever hold a session; keep public sign-ups disabled.
ADMIN_EMAILS=
